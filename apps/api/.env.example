PORT=4000

# For serverless/pooled Postgres providers (e.g. Neon), append a
# connection_limit query param sized for your deployment target
# (e.g. ?connection_limit=5) so multiple app instances/rolling deploys
# don't exhaust the provider's total connection ceiling.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
FRONTEND_ORIGIN="http://localhost:5173"

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL="info"

# Optional — leave unset to log verification/reset links to the console
# instead of sending real email (dev-friendly default). Get an API key at
# https://resend.com; EMAIL_FROM must be either their shared sandbox
# sender (onboarding@resend.dev, only delivers to your own Resend account
# email) or an address on a domain you've verified with Resend.
RESEND_API_KEY=""
EMAIL_FROM="Marché <onboarding@resend.dev>"
