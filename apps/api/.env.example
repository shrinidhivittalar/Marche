PORT=4000
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
FRONTEND_ORIGIN="http://localhost:5173"

# Optional — leave unset to log verification/reset links to the console
# instead of sending real email (dev-friendly default). Get an API key at
# https://resend.com; EMAIL_FROM must be either their shared sandbox
# sender (onboarding@resend.dev, only delivers to your own Resend account
# email) or an address on a domain you've verified with Resend.
RESEND_API_KEY=""
EMAIL_FROM="Marche <onboarding@resend.dev>"
