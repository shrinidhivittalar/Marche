VITE_API_URL="http://localhost:4000"

# OPTIONAL — powers "Continue with Google" on the sign-in page
# (src/lib/google-identity.ts). Leave unset and the button hides itself
# rather than rendering something that can't work — see AuthSignInPage.
# Must be the exact same OAuth 2.0 Client ID as the backend's
# GOOGLE_CLIENT_ID (apps/api/.env.example) — a mismatch here fails Google
# sign-in with a confusing error, not a clear "wrong config" one, since
# each side validates independently. Get it at
# https://console.cloud.google.com/apis/credentials — not a secret.
VITE_GOOGLE_CLIENT_ID=""
