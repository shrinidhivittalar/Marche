# Every variable below is either REQUIRED or OPTIONAL. REQUIRED ones are
# checked at process startup (apps/api/src/config/env.validation.ts) — the
# app refuses to boot without them, with every missing one listed at once.
# OPTIONAL ones each have a documented fallback/degraded behaviour in the
# module that reads them.

# OPTIONAL — Render (and most hosts) inject this themselves at runtime.
PORT=4000

# OPTIONAL — development | production | test. Controls pino-pretty vs JSON
# logging (app.module.ts) and the dev-only Swagger UI (main.ts).
NODE_ENV="development"

# REQUIRED — Prisma cannot connect to Postgres without it.
# For serverless/pooled Postgres providers (e.g. Neon), append a
# connection_limit query param sized for your deployment target
# (e.g. ?connection_limit=5) so multiple app instances/rolling deploys
# don't exhaust the provider's total connection ceiling.
#
# Production (Render): the agreed value is connection_limit=5 — the live
# DATABASE_URL on Render must end in ?connection_limit=5 (or
# &connection_limit=5 if other query params already precede it). That value
# is set directly on the Render dashboard (marche-api -> Environment), never
# committed here — this repo cannot verify or enforce it, only document it.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# REQUIRED in production (NODE_ENV=production), OPTIONAL elsewhere — backs
# rate limiting (app.module.ts's ThrottlerModule and the email-keyed
# EmailThrottlerGuard on auth routes). Outside production, leave unset and it
# falls back to a per-process, in-memory store (logs a warning on boot) —
# fine for local dev and tests. In production that fallback isn't
# acceptable (limits aren't shared across instances and reset on every
# redeploy), so env.validation.ts requires this whenever NODE_ENV=production
# and the app refuses to boot without it.
REDIS_URL="redis://user:password@host:port"

# REQUIRED — IdentityModule's JwtModule.register reads this at decoration
# time, before the app's own env validation would otherwise get a chance to
# run. Unset, every signed access token is invalid.
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"

# REQUIRED — the one canonical frontend URL, used for every emailed link
# (verification, password reset, invites). Not the CORS allow-list — see
# CORS_ORIGINS below for which browser origins may call the API.
FRONTEND_ORIGIN="http://localhost:5173"

# REQUIRED — comma-separated list of browser origins allowed to call the API
# with credentials (cookies). Parsed by splitting on commas, trimming
# whitespace, and dropping empty entries — see config/cors-origins.ts. No
# wildcard, no implicit localhost fallback in any environment: set this
# explicitly even for local dev.
#   Local dev:  CORS_ORIGINS="http://localhost:5173"
#   Production: CORS_ORIGINS="https://marche.app,https://staging.marche.app"
CORS_ORIGINS="http://localhost:5173"

# OPTIONAL — pino log level: trace | debug | info | warn | error | fatal.
LOG_LEVEL="info"

# OPTIONAL — leave SMTP_HOST unset to log verification/reset links to the
# console instead of sending real email (dev-friendly default). Fill in your
# SMTP provider's host/port/credentials to send for real. SMTP_USER can be
# left unset for a server that doesn't require auth.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Marché <no-reply@example.com>"

# OPTIONAL — powers "Rephrase with AI" on the job-posting form. Leave unset
# and that one button errors; nothing else depends on it. Get a key at
# https://console.groq.com/keys.
GROQ_API_KEY=""

# REQUIRED — PaymentsModule's RazorpayClient throws on construction without
# all three. Get RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET from Settings ->
# API Keys in the Razorpay dashboard (test mode needs no business KYC).
# RAZORPAY_WEBHOOK_SECRET is set when you create the webhook itself
# (Settings -> Webhooks) — it's a value you choose, not one Razorpay
# generates, and it must match what you enter there.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# OPTIONAL — object storage for uploads (S3-compatible: Cloudflare R2, MinIO,
# AWS S3). Leave unset and file uploads fail with a clear "not configured"
# error; every other module (auth, profiles, marketplace, jobs, ...) keeps
# working. See media/storage.service.ts.
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET=""
STORAGE_REGION="auto"

# OPTIONAL — upload limits, presigned-URL TTLs, and the age at which an
# abandoned upload is swept. Sensible defaults in media/media.config.ts;
# override only if you need different numbers. See that file for units.
MEDIA_MAX_IMAGE_SIZE=""
MEDIA_MAX_DOCUMENT_SIZE=""
MEDIA_UPLOAD_URL_TTL=""
MEDIA_DOWNLOAD_URL_TTL=""
MEDIA_ORPHAN_AGE_MINUTES=""

# OPTIONAL — overrides the default auth-route rate limit (5/min). Used by
# the e2e suite, which signs in far more often than a human would. See
# identity/auth-rate-limit.ts.
AUTH_RATE_LIMIT=""
