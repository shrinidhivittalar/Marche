# For serverless/pooled Postgres providers (e.g. Neon), append a
# connection_limit query param sized for your deployment target
# (e.g. ?connection_limit=5) so multiple app instances/rolling deploys
# don't exhaust the provider's total connection ceiling.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Direct (non-pooled) connection string — same database as DATABASE_URL
# above, different endpoint. Required by schema.prisma's datasource.directUrl:
# `prisma migrate`/`db push`/introspect must not run over a pooled (PgBouncer)
# connection, since the advisory lock they take can be handed off to an
# unrelated pooled client once the migration process exits, orphaning the
# lock and blocking every subsequent migrate with a P1002 timeout. On Neon,
# copy the "Direct connection" string from the same database (Console →
# Connection Details → toggle off "Pooled connection") — it differs from
# DATABASE_URL by omitting the "-pooler" segment in the hostname.
#
# NOTE: db:test:prepare's `migrate deploy` against TEST_DATABASE_URL below
# needs this too, since that endpoint is also pooled ("-pooler" in its
# hostname) — not addressed by this addition; migrate commands against
# TEST_DATABASE_URL will fail until a direct counterpart is set up for it
# as well.
DIRECT_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# The database the end-to-end suite runs against. It must not be the one
# above: the suite registers accounts, publishes listings and deletes them
# again, and a teardown that fails half-way would leave that in real data.
#
# On Neon, create a second database in the same project (Console → Databases
# → New database, e.g. "marche_test") and copy the connection string, which
# differs from DATABASE_URL only in the database name at the end. Then run
# `npm run db:test:prepare` from the repo root to migrate and seed it.
#
# Nothing reads this except the e2e suite (apps/web/playwright.config.ts) and
# that prepare script; the application never sees it.
TEST_DATABASE_URL="postgresql://user:password@host/dbname_test?sslmode=require"
