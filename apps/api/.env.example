PORT=4000

# For serverless/pooled Postgres providers (e.g. Neon), append a
# connection_limit query param sized for your deployment target
# (e.g. ?connection_limit=5) so multiple app instances/rolling deploys
# don't exhaust the provider's total connection ceiling.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
FRONTEND_ORIGIN="http://localhost:5173"

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL="info"

# Optional — leave SMTP_HOST unset to log verification/reset links to the
# console instead of sending real email (dev-friendly default). Fill in your
# SMTP provider's host/port/credentials to send for real. SMTP_USER can be
# left unset for a server that doesn't require auth.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Marché <no-reply@example.com>"

# Optional — powers "Rephrase with AI" on the job-posting form. Leave unset
# and that one button errors; nothing else depends on it. Get a key at
# https://console.groq.com/keys.
GROQ_API_KEY=""

# S3-compatible object storage, for avatars, portfolio images, service
# images and requirement attachments. Optional in the same way GROQ_API_KEY
# is: leave these unset and the API still starts — only upload requests
# fail, with a message naming what is missing (see media/storage.service.ts,
# which builds its client on first use rather than at boot for exactly that
# reason). STORAGE_REGION defaults to "auto", which is what R2 wants; S3
# needs its real region.
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET=""
STORAGE_REGION="auto"

# Optional — all have working defaults, listed here because they are the
# knobs worth knowing about. Sizes are bytes, TTLs seconds, orphan age
# minutes. See media/media.config.ts.
# MEDIA_MAX_IMAGE_SIZE=10485760
# MEDIA_MAX_DOCUMENT_SIZE=20971520
# MEDIA_UPLOAD_URL_TTL=300
# MEDIA_DOWNLOAD_URL_TTL=3600
# MEDIA_ORPHAN_AGE_MINUTES=60

# Optional — requests per minute allowed on the auth routes, per IP.
# Defaults to 5. The e2e suite raises it for its own server only.
# AUTH_RATE_LIMIT=5
