PORT=4000

# For serverless/pooled Postgres providers (e.g. Neon), append a
# connection_limit query param sized for your deployment target
# (e.g. ?connection_limit=5) so multiple app instances/rolling deploys
# don't exhaust the provider's total connection ceiling.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Backs rate limiting (app.module.ts's ThrottlerModule and the email-keyed
# EmailThrottlerGuard on auth routes). Required — there is no in-memory
# fallback, since that resets on every redeploy and doesn't work once there
# is more than one API instance.
REDIS_URL="redis://user:password@host:port"

JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
FRONTEND_ORIGIN="http://localhost:5173"

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL="info"

# Optional — leave SMTP_HOST unset to log verification/reset links to the
# console instead of sending real email (dev-friendly default). Fill in your
# SMTP provider's host/port/credentials to send for real. SMTP_USER can be
# left unset for a server that doesn't require auth.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Marché <no-reply@example.com>"

# Optional — powers "Rephrase with AI" on the job-posting form. Leave unset
# and that one button errors; nothing else depends on it. Get a key at
# https://console.groq.com/keys.
GROQ_API_KEY=""

# Required — the payments module (apps/api/src/payments) throws on boot
# without all three, same as REDIS_URL above. Get RAZORPAY_KEY_ID and
# RAZORPAY_KEY_SECRET from Settings -> API Keys in the Razorpay dashboard
# (test mode needs no business KYC). RAZORPAY_WEBHOOK_SECRET is set when you
# create the webhook itself (Settings -> Webhooks) — it's a value you choose,
# not one Razorpay generates, and it must match what you enter there.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
