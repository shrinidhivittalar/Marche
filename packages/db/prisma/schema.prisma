// Identity module schema (docs/module1.md, docs/database1.0.0.md).
// Additional modules (Profile, Marketplace, Jobs, ...) will extend this file
// as their turn comes up in the phase_scope roadmap.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
  DELETED
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String
  name            String
  role            UserRole
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions           Session[]
  verificationTokens VerificationToken[]
  passwordResets     PasswordReset[]
  profile            Profile?
  media              Media[]
  notifications      Notification[]
  reviewsWritten     Review[]
  sentMessages       Message[]

  @@map("users")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("verification_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_resets")
}

// Generic, cross-module security audit trail — not just Identity events.
// eventType is a plain string ("auth.login.success", later "jobs.created",
// "contracts.signed", etc.) instead of an enum on purpose, so every future
// module can log into this same table without a schema migration; the set
// of valid event types lives in application code (apps/api/src/audit),
// not the database.
//
// userId is intentionally NOT a foreign key to User. An audit trail must
// survive account deletion (that's the whole point of an audit trail) —
// a real FK with onDelete:Cascade would silently erase history exactly
// when it matters most (e.g. investigating a deleted account).
//
// Scoped to security-relevant events only (auth attempts, password
// resets, ...) — never click/page-view tracking, which belongs in a
// dedicated analytics tool, not this database.
model AuditLog {
  id        String  @id @default(uuid())
  eventType String
  userId    String?
  email     String?
  ipAddress String?
  userAgent String?
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("audit_logs")
}

// Profile module schema (docs/modules/module2.md, docs/modules/module2-edge-cases.md).
//
// Deliberate deviations from module2.md, decided during edge-case review:
// - One shared Profile table for both Client and Provider roles, not
//   separate ProviderProfile/ClientProfile tables (see database1.1.0.md).
// - No ProfileStatistics table: stats are computed on read from
//   Contracts/Reviews once those modules exist, not cached here — a cache
//   has nothing to drift from if it doesn't exist.
// - No file-upload handling yet: avatar/image fields are plain URL strings;
//   endpoints accept an already-hosted URL until object storage (R2) is
//   set up. See module2-edge-cases.md's Portfolio section for the ordering
//   this implies once real uploads are wired in (storage write must
//   succeed before the DB row is created, to avoid orphaned rows).

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum AvailabilityStatus {
  AVAILABLE
  LIMITED
  UNAVAILABLE
}

enum LanguageProficiency {
  BASIC
  CONVERSATIONAL
  FLUENT
  NATIVE
}

// Provider onboarding-wizard answers (Q1/Q2/Q3 in ProviderOnboardingPage).
enum ProviderExperienceLevel {
  NEW
  SOME_EXPERIENCE
  EXPERT
}

enum ProviderGoal {
  MAIN_INCOME
  SIDE_INCOME
  EXPERIENCE
  UNDECIDED
}

enum ProviderWorkPreference {
  FIND_OPPORTUNITIES
  PACKAGE_SERVICES
  CONTRACT_TO_HIRE
}

model Profile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Nullable until set — see module2-edge-cases.md's "Open questions"
  // section (username shape was an unresolved gap in module2.md itself).
  username      String? @unique
  displayName   String
  headline      String?
  bio           String?
  // Uploaded file rather than a pasted URL. SetNull so deleting the image
  // leaves the profile intact and simply avatar-less, which is a real state
  // — unlike a portfolio piece, a profile without a picture still works.
  avatarMediaId String?
  avatarMedia   Media?  @relation(fields: [avatarMediaId], references: [id], onDelete: SetNull)
  location      String?
  timezone      String?
  socialLinks   Json?

  // Onboarding-wizard answers. Asked on both onboarding screens, previously
  // collected in local component state and discarded on submit — nothing
  // read them, and there was nowhere to put them. Nullable/empty until a
  // caller actually sends one; no Phase 1 feature reads them back yet
  // either, so they are stored as asked and left for a later feature to
  // consume rather than driving any behaviour today.
  experienceLevel ProviderExperienceLevel?
  primaryGoal     ProviderGoal?
  workPreferences ProviderWorkPreference[]
  // Client-side onboarding answers, same story.
  orgSize String?
  website String?

  visibility         ProfileVisibility  @default(PUBLIC)
  availabilityStatus AvailabilityStatus @default(AVAILABLE)
  nextAvailableDate  DateTime?

  // Lightweight, system-computed badge — not identity/KYC verification,
  // which remains out of Phase 1 scope (phase_scope1.1.0.md).
  verifiedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  portfolioItems Portfolio[]
  experiences    Experience[]
  educations     Education[]
  certifications Certification[]
  skills         UserSkill[]
  languages      UserLanguage[]
  services       Service[]
  jobs           Job[]

  // Module 5. `proposals` needs no relation name (it is the only Proposal
  // relation to Profile); the two Connection sides do, because a Profile can
  // sit on either end of the same table.
  proposals           Proposal[]
  clientConnections   Connection[] @relation("ClientConnections")
  providerConnections Connection[] @relation("ProviderConnections")
  reviewsReceived     Review[]

  @@map("profiles")
}

model Portfolio {
  id          String            @id @default(uuid())
  profileId   String
  profile     Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String
  category    String?
  coverImage  String?
  projectDate DateTime?
  visibility  ProfileVisibility @default(PUBLIC)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  images PortfolioImage[]

  @@index([profileId])
  @@map("portfolio_items")
}

// Now a join between a portfolio piece and an uploaded file, rather than a
// pasted URL. No URL is stored: one is signed at read time from the media's
// objectKey, so moving bucket or provider never means rewriting rows.
model PortfolioImage {
  id          String    @id @default(uuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  // Restrict, not cascade: deleting a file that is still on someone's
  // published portfolio should fail loudly rather than silently blank the
  // piece. The owner detaches it first.
  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  // The same file twice in one piece is a mistake, not a feature.
  @@unique([portfolioId, mediaId])
  @@index([portfolioId])
  @@map("portfolio_images")
}

model Experience {
  id               String    @id @default(uuid())
  profileId        String
  profile          Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company          String
  position         String
  description      String?
  startDate        DateTime
  endDate          DateTime?
  currentlyWorking Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@map("experiences")
}

model Education {
  id             String  @id @default(uuid())
  profileId      String
  profile        Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution    String
  degree         String
  fieldOfStudy   String?
  graduationYear Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@map("educations")
}

model Certification {
  id                  String    @id @default(uuid())
  profileId           String
  profile             Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name                String
  issuingOrganization String
  issueDate           DateTime?
  expiryDate          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@map("certifications")
}

// Predefined, platform-wide skill list — not user-created. Seeded once,
// referenced by UserSkill and (from Module 3) ServiceSkill.
model Skill {
  id   String @id @default(uuid())
  name String @unique

  userSkills    UserSkill[]
  serviceSkills ServiceSkill[]

  @@map("skills")
}

model UserSkill {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([profileId, skillId])
  @@index([profileId])
  @@map("user_skills")
}

model UserLanguage {
  id          String              @id @default(uuid())
  profileId   String
  profile     Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  language    String
  proficiency LanguageProficiency

  createdAt DateTime @default(now())

  @@unique([profileId, language])
  @@index([profileId])
  @@map("user_languages")
}

// Marketplace module schema (docs/modules/module3.md,
// docs/modules/module3-edge-cases.md).
//
// Deliberate deviations from database1.2.0.md's original table list,
// decided during the spec/edge-case review:
// - No SubCategory table: a nullable self-referencing Category.parentId
//   expresses the same two-level taxonomy without a second table and a
//   second set of CRUD paths.
// - No ServiceImage table: deferred with Portfolio uploads until object
//   storage (R2) exists, so the upload pipeline is built once rather than
//   twice. Cards use the Profile avatar and portfolio previews meanwhile.
// - No ServicePackage table: a single starting price per Service in
//   Phase 1. Tiered pricing is the one deferral with real migration cost,
//   which is exactly why it isn't built speculatively.

enum ServiceStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

// Platform-defined discovery taxonomy — seeded and admin-managed, never
// user-created. Same lifecycle as Skill.
//
// Hierarchy is two levels by convention (a parent and its children), even
// though parentId is structurally unbounded: forbidding a child-of-a-child
// in application code keeps every category query a single join instead of
// a recursive CTE. Deeper nesting stays possible later without a
// migration if it's ever genuinely needed.
//
// No separate "status" column: module3.md lists one, but deletedAt already
// answers "should this appear?", and two independent ways to hide the same
// row is how a category ends up visible in one query and missing from
// another.
model Category {
  id           String  @id @default(uuid())
  name         String
  slug         String  @unique
  description  String?
  icon         String?
  displayOrder Int     @default(0)

  // Restrict, not the SET NULL Prisma would default to: deleting a parent
  // that still has children must fail, not silently promote them to
  // top-level and quietly restructure the taxonomy. The service layer
  // checks first and returns a 409; this is the backstop.
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  services Service[]
  jobs     Job[]

  @@index([parentId])
  @@map("categories")
}

// A provider's discoverable offering.
//
// onDelete is deliberately omitted on the category relation (Prisma
// defaults to Restrict for a required relation): deleting a category that
// still has services must fail loudly rather than cascade away providers'
// listings.
//
// status is the single visibility control — module3.md lists both "Status"
// and "Visibility", but they are the same fact, and two fields would let
// a service be PUBLISHED-but-hidden with no defined meaning.
model Service {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  title         String
  description   String
  startingPrice Decimal @db.Decimal(10, 2)
  deliveryDays  Int

  status ServiceStatus @default(DRAFT)

  // Free-text, provider-authored. Deliberately NOT a filter and NOT a
  // join table: tags exist so a provider whose work isn't in the seeded
  // Skill list has somewhere to put it, and they feed keyword search and
  // card display only. Filtering on free text fragments ("Photography" /
  // "photography" / "photo") and would quietly return wrong results — a
  // tag that earns filtering gets promoted to a seeded Skill instead.
  tags String[] @default([])

  // Set on first publish only, never overwritten on republish, so
  // toggling publish state can't bump a listing up the "newest" sort.
  publishedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  skills ServiceSkill[]
  images ServiceImage[]

  @@index([profileId])
  @@index([categoryId])
  // Serves the default browse query: published services, newest first.
  @@index([status, createdAt])
  @@map("services")
}

// Deferred out of Module 3 because image handling was pasted-URL-only at
// the time (phase_scope1.2.0.md). The upload pipeline is what makes this
// worth building, so it lands here rather than as a third URL-string table.
model ServiceImage {
  id        String  @id @default(uuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  // Which image leads on the card. Explicit rather than "first by
  // createdAt", so reordering does not depend on insertion order.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@unique([serviceId, mediaId])
  @@index([serviceId])
  @@map("service_images")
}

// Maps a Service to the seeded, platform-wide Skill list. These are the
// values discovery filters on, which is why they're constrained to a
// controlled vocabulary rather than free text.
model ServiceSkill {
  id        String  @id @default(uuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([serviceId, skillId])
  @@index([serviceId])
  // Supports the reverse lookup — "which services have this skill?" — which
  // is the direction the skill filter actually queries.
  @@index([skillId])
  @@map("service_skills")
}

// ---------------------------------------------------------------------------
// Module 4 — Jobs (Requirements)
// ---------------------------------------------------------------------------
//
// A Job is the client side of the marketplace: "here is what I need", posted
// for providers to find. "Requirement" is the product word for the same
// thing; "Job" is the domain word, and only this one appears in code.
//
// Deliberate omissions, each of which module4.md lists:
//
// - No `visibility` column. module4.md specifies status and visibility as
//   separate concepts, but a PUBLISHED-yet-PRIVATE job has no audience in
//   Phase 1: there is no invite, no share link, nothing that would let
//   anyone reach it. DRAFT already means "only the owner sees this". This
//   is the same call the Service model made for the same reason.
//
// - No PROPOSAL_ACTIVITY status. It is derivable — a job either has
//   proposals or it does not — and storing a derived fact means Module 5
//   must remember to flip it on every proposal, and unflip it on every
//   withdrawal. Module 5 counts proposals instead.
//
// - No `deadline`. module4.md defines eventDate (when the work happens) and
//   deadline (when it must be delivered), then says to ship one if only one
//   is needed. Two date fields whose difference nobody can articulate is how
//   both end up populated inconsistently.
enum JobStatus {
  DRAFT
  PUBLISHED
  FILLED
  CANCELLED
}

model Job {
  id String @id @default(uuid())

  // The owning client, by profile rather than user — matching Service,
  // which hangs off Profile for the same reason: discovery needs the
  // poster's display name and location, and a Profile is guaranteed to
  // exist from registration onward. Role is still read through
  // profile.user.role, since role is a user-level fact.
  clientProfileId String
  clientProfile   Profile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  // onDelete omitted, so Prisma's Restrict applies: deleting a category
  // that still has jobs must fail loudly rather than cascade away clients'
  // requirements.
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  title       String
  description String

  // Both optional and both a range, because a client posting work often
  // knows "somewhere between X and Y" and not an exact figure. Ordering
  // (min <= max) is enforced in the DTO, where the caller gets told which
  // way round it should be.
  budgetMin Decimal? @db.Decimal(10, 2)
  budgetMax Decimal? @db.Decimal(10, 2)

  location  String?
  eventDate DateTime?

  // Wall-clock "HH:MM" strings, not DateTimes, and deliberately so. These
  // are the hours of an event at its own venue: a 6pm ceremony is at 6pm
  // for everyone standing in the room, whatever timezone the server or the
  // reader is in. Storing them as instants would make the displayed time
  // depend on who is looking, which is precisely wrong for this field.
  //
  // Only meaningful alongside eventDate; the DTO enforces that.
  eventStartTime String?
  eventEndTime   String?

  // The cutoff for providers to propose. Job-side rather than Proposal-side:
  // it is the client's term for their own requirement, and it must exist
  // before any proposal does. Module 5 reads it to refuse late proposals.
  proposalDeadline DateTime?

  // What the client expects delivered — the part providers actually price
  // against. A String[] rather than a table for the same reason Service.tags
  // is: they are free text written once by one person, displayed as written,
  // and never filtered on.
  deliverables String[] @default([])

  status JobStatus @default(DRAFT)

  // Set on first publish and never rewritten, so cancelling and reposting
  // cannot bump a job up the "newest" sort. Same rule as Service.
  publishedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  attachments JobAttachment[]

  // Module 5. The connection is singular because only one proposal can ever
  // be accepted — enforced by a unique constraint on Connection.jobId, not
  // merely by this field's shape.
  proposals  Proposal[]
  connection Connection?

  @@index([clientProfileId])
  @@index([categoryId])
  // Serves the provider discovery query: published jobs, newest first.
  @@index([status, publishedAt])
  // Serves the event_date sort and the "happening before X" filter.
  @@index([eventDate])
  // Serves "still open for proposals", which Module 5 checks on every
  // submission and discovery will want once expiry exists.
  @@index([proposalDeadline])
  @@map("jobs")
}

// A file the client attached to their requirement — a floor plan, a mood
// board, a brief.
//
// These are uploaded as PRIVATE media, unlike portfolio and service images.
// A portfolio photo is advertising and is meant to be seen; a requirement's
// attachment is working material that may name a venue, a guest list or a
// budget. Nothing is served from the public requirement route because of
// it: attachments have their own authenticated endpoint, so who may see a
// file is decided in one place rather than inferred from where it appears.
model JobAttachment {
  id    String @id @default(uuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Restrict, matching PortfolioImage and ServiceImage: deleting a file
  // still attached to a live requirement must fail loudly rather than
  // silently blank it. The owner detaches it first.
  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  // Explicit rather than "first by createdAt", so ordering does not depend
  // on insertion order. Same reasoning as ServiceImage.sortOrder.
  displayOrder Int @default(0)

  createdAt DateTime @default(now())

  // The same file twice on one requirement is a mistake, not a feature.
  @@unique([jobId, mediaId])
  @@index([jobId])
  @@map("job_attachments")
}

// ---------------------------------------------------------------------------
// Module 5 — Proposals
// ---------------------------------------------------------------------------
//
// A Proposal is the provider side of the marketplace: "here is what I will do
// and what it costs", offered against one client's requirement. Accepting one
// is the moment a hire actually happens, which makes this the first genuinely
// transactional corner of the schema.
//
// Deliberate omissions, each argued in module5.md and recorded here so the
// reasoning sits next to the thing it shaped:
//
// - No DRAFT status. A proposal is submitted complete, in one operation. A
//   draft state means storing half-written offers to support a form the
//   frontend can hold in local state until it is ready.
//
// - No `deletedAt`. Nothing deletes a proposal: all three end states are
//   retained on purpose, because a proposal is the record of what was
//   offered. A soft-delete column nothing ever writes is one that will
//   eventually be misread as meaning something.
//
// - No rejection reason. Nothing would read it until Notifications exists,
//   and a write-only column is a field that quietly drifts out of date.
//
// - No `providerUserId` alongside `providerProfileId`. That is the same fact
//   twice and two columns that can disagree. Job made the same call with
//   `clientProfileId`; role is read through `profile.user.role`, since role
//   is a user-level fact.
enum ProposalStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Proposal {
  id String @id @default(uuid())

  // Cascade: a requirement that is genuinely deleted takes its proposals
  // with it. Reachable only through a deleted client profile — Module 4
  // permits hard-deleting nothing else, and a DRAFT job (the one thing it
  // does delete) can never have proposals, since drafts are not discoverable.
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  providerProfileId String
  providerProfile   Profile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  // A snapshot of what was offered, not a live join to the provider's
  // Service or Profile. If the provider later raises their prices, this
  // proposal must still say what the client read when they shortlisted it.
  coverMessage  String
  proposedPrice Decimal @db.Decimal(10, 2)

  // Days, and named so. "deliveryTime" leaves the unit to be guessed at by
  // whoever reads it next.
  deliveryDays Int

  status ProposalStatus @default(SUBMITTED)

  // submittedAt is separate from createdAt even though Phase 1 writes both
  // at once: createdAt is a row fact, submittedAt is a business fact, and
  // the two stop being the same instant the moment drafts ever exist.
  submittedAt DateTime  @default(now())
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  withdrawnAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments ProposalAttachment[]
  connection  Connection?

  // The rule the whole module turns on: one proposal per provider per
  // requirement. Absolute, not partial — so withdrawal is final for that
  // requirement. A partial index (WHERE status = 'SUBMITTED') would allow
  // re-proposing, but Prisma cannot express one, and a constraint that does
  // not appear in this file is a constraint someone will later violate in a
  // query they believed was safe.
  //
  // This is also the enforcement, not the service-layer pre-check: two
  // simultaneous submissions both pass that check before either writes.
  @@unique([jobId, providerProfileId])
  // Serves the client's review list — the proposals on one requirement,
  // optionally filtered by status. Leading on jobId, so it serves the
  // unfiltered list too and a separate jobId index would be redundant.
  @@index([jobId, status])
  // The mirror: a provider's own proposals, optionally filtered.
  @@index([providerProfileId, status])
  @@map("proposals")
}

// A file the provider attached to their offer — a quote, a sample, a shot
// list.
//
// Private, exactly like JobAttachment and for the same reason: this is
// working material between two parties, not advertising. Nothing is served
// from a public route because of it.
model ProposalAttachment {
  id         String   @id @default(uuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  // Restrict, matching every other media join: deleting a file still
  // attached to a live proposal must fail loudly rather than silently blank
  // it. The owner detaches it first.
  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  displayOrder Int @default(0)

  createdAt DateTime @default(now())

  @@unique([proposalId, mediaId])
  @@index([proposalId])
  @@map("proposal_attachments")
}

// The hiring relationship, created when a client accepts a proposal.
//
// Its own row rather than "a proposal in the accepted state", because
// everything downstream — messaging, contracts, payments — belongs to *two
// parties for one job*, and a Proposal row is a historical record of what was
// offered, not a live thing two parties act through.
//
// Created only inside the acceptance transaction. There is no POST route, so
// nobody can manufacture a relationship without an accepted proposal.
//
// No status column. Phase 1 only ever writes one value, so the row existing
// is what "active" means; a one-member enum is a column whose value is
// already implied by the primary key. Closing arrives with the module that
// needs a second state, and brings its own migration either way.
// module5-completion.md. COMPLETED only ever means "the client confirmed, or
// the event happened and enough time passed that a stalled confirmation
// stopped blocking the parties from reviewing each other" — never a payment
// or escrow state, since neither exists yet. See ConnectionsService for the
// two ways a row gets here.
enum ConnectionStatus {
  ACTIVE
  COMPLETED
}

model Connection {
  id String @id @default(uuid())

  // Unique, and this is load-bearing: it is the backstop that makes "exactly
  // one winner" true even if the acceptance transaction is ever reordered or
  // retried after a lost response. The conditional claim on Job.status is the
  // primary mechanism (see ADR-006); this is what catches it if that breaks.
  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Also unique: one accepted proposal produces one relationship.
  proposalId String   @unique
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  // Both parties are denormalised onto the row rather than being read through
  // job.clientProfile and proposal.providerProfile. This is the one place in
  // the schema where that is worth it: "my connections" is a query from
  // either side, and without these columns it needs two joins in one
  // direction and three in the other. Neither value can drift — a connection
  // is immutable once created.
  clientProfileId String
  clientProfile   Profile @relation("ClientConnections", fields: [clientProfileId], references: [id], onDelete: Cascade)

  providerProfileId String
  providerProfile   Profile @relation("ProviderConnections", fields: [providerProfileId], references: [id], onDelete: Cascade)

  // Defaults ACTIVE. Client-confirmed or auto-completed — see
  // ConnectionsService.confirmComplete and .autoCompleteEligibleWhere.
  // completedAt is null until either happens; once set, it never moves,
  // even though which of the two paths set it is not itself recorded (the
  // distinction has no consumer — Reviews eligibility only needs COMPLETED).
  status      ConnectionStatus @default(ACTIVE)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews  Review[]
  messages Message[]

  // Serve "my connections" from either side.
  @@index([clientProfileId])
  @@index([providerProfileId])
  // Serves the auto-complete sweep: every ACTIVE row, cheaply.
  @@index([status])
  @@map("connections")
}

// Media / upload pipeline (shared infrastructure, not a business module).
//
// One table serving Portfolio, Service images and — once Module 4 exists —
// Job and Proposal attachments. Media deliberately knows nothing about any
// of them: business entities hold a mediaId, never the reverse. That is
// what stops this becoming a dumping ground that every new module has to
// extend.
//
// The database stores ownership and metadata. The bytes live in object
// storage, and nothing in this schema references a URL — a URL is derived
// from objectKey at read time, so moving buckets or providers never
// requires a data migration.

enum MediaStatus {
  PENDING
  UPLOADED
  FAILED
  DELETED
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

model Media {
  id String @id @default(uuid())

  // Not a cascade delete to User: a soft-deleted account's media must not
  // vanish from under a published listing mid-request. Cleanup is a
  // deliberate action, not a side effect of account deletion.
  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id])

  // Server-generated, always users/{userId}/{uuid}. The client never picks
  // a path — an attacker-chosen key is how you get collisions and traversal.
  // Unique so a retry can never quietly overwrite someone else's object.
  objectKey String @unique

  // Metadata only. Never used as a storage path, and never trusted: the
  // declared mimeType is what the client claims, and is re-verified against
  // the file's actual signature before the row reaches UPLOADED.
  originalFileName String
  mimeType         String
  sizeBytes        Int

  // PENDING until the object is confirmed present in storage. Anything that
  // never completes is an abandoned upload, not a file — attaching one would
  // put a broken image on a public profile.
  status MediaStatus @default(PENDING)

  // Phase 1 issues PUBLIC only. PRIVATE lands with Job and Proposal
  // attachments in Module 4, when there is finally something worth
  // protecting; the column exists now so that is a behaviour change rather
  // than a migration.
  visibility MediaVisibility @default(PUBLIC)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  portfolioImages     PortfolioImage[]
  serviceImages       ServiceImage[]
  jobAttachments      JobAttachment[]
  proposalAttachments ProposalAttachment[]
  avatarForProfiles   Profile[]

  @@index([ownerUserId])
  // Serves the orphan sweep: stale PENDING rows, oldest first.
  @@index([status, createdAt])
  @@map("media")
}

// Phase 1 event types only (docs/module6.md). Not client-writable — a
// notification's type is always chosen by the server-side code path that
// creates it, never accepted as API input.
enum NotificationType {
  PROPOSAL_SUBMITTED
  PROPOSAL_WITHDRAWN
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  CONNECTION_ESTABLISHED
  JOB_CANCELLED
}

model Notification {
  id String @id @default(uuid())

  // Cascade: a notification with no user behind it is not a record worth
  // keeping. Unlike Media, nothing else can still reference this row once
  // the user is gone.
  recipientUserId String
  recipient       User   @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  type NotificationType

  title   String
  message String

  // Safe navigation metadata only (ids), never tokens, secrets, or private
  // URLs. See docs/module6.md's "Important Rule" — the endpoint a deep link
  // points to must still enforce its own authorization on read.
  data Json?

  // Null = unread. A timestamp, not a boolean, so read state also records
  // when.
  readAt DateTime?

  createdAt DateTime @default(now())

  // Serves the notification list, newest first, for one recipient.
  @@index([recipientUserId, createdAt])
  // Serves the unread-count query.
  @@index([recipientUserId, readAt])
  @@map("notifications")
}

// module5-reviews.md. Two-way: both parties to a COMPLETED Connection may
// review the other, once each. Eligibility (COMPLETED + is a party + not
// already reviewed) lives in ReviewsService, not here — same split as every
// other module in this schema.
//
// Blind until both sides have reviewed, or a window elapses — Fiverr's rule,
// adopted because the alternative (reviews visible immediately) lets a
// reviewer copy or retaliate against the other side's review before writing
// their own, which defeats the point of asking both sides independently.
// Computed at read time (ReviewsService), not stored: whether a review is
// visible depends on whether its sibling exists yet, which can change after
// the row is written, and a stored flag would need the same lazy sweep
// pattern as Connection.status for the window half of the rule anyway.
model Review {
  id String @id @default(uuid())

  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  // Cascade: a review with no author behind it is not a record worth
  // keeping, same reasoning as Notification.recipient and Message.sender.
  reviewerUserId String
  reviewer       User   @relation(fields: [reviewerUserId], references: [id], onDelete: Cascade)

  // The profile being reviewed — not a User, because a review is about the
  // public reputation a profile carries, which is what PublicProfilePage
  // reads. SetNull rather than cascade: a review is evidence about a
  // completed transaction and must survive the reviewee deleting their
  // account, the same way Media.ownerUserId is deliberately not a cascade.
  revieweeProfileId String?
  revieweeProfile   Profile? @relation(fields: [revieweeProfileId], references: [id], onDelete: SetNull)

  rating  Int
  comment String

  createdAt DateTime @default(now())

  // One review per reviewer per connection — the eligibility check
  // (ReviewsService) enforces "not already reviewed" in application code,
  // but a unique constraint is what makes a race between two concurrent
  // submissions from the same party impossible rather than merely unlikely.
  @@unique([connectionId, reviewerUserId])
  // Serves "reviews for this connection" (mutual-visibility check) and
  // "reviews for this profile" (public listing), newest first.
  @@index([connectionId])
  @@index([revieweeProfileId, createdAt])
  @@map("reviews")
}

// Chat between the two parties on a Connection (module5.md). There is no
// broader inbox concept — a conversation only exists because a proposal was
// accepted, exactly like the Connection it belongs to, so cascading with it
// is correct rather than orphaning history nobody can read anyway (both
// parties' access is gated by being on that Connection).
model Message {
  id String @id @default(uuid())

  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  // The sender is always one of the connection's two parties, enforced at
  // the service layer (like Notification's recipient, not something this
  // table can check on its own). Cascade for the same reason as
  // Notification.recipient: a message with no sender behind it is not a
  // record worth keeping.
  senderUserId String
  sender       User   @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  body String

  // Null = unread, same convention as Notification.readAt.
  readAt DateTime?

  createdAt DateTime @default(now())

  // Serves the thread for one connection, oldest first.
  @@index([connectionId, createdAt])
  @@map("messages")
}
